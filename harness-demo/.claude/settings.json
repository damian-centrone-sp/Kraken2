{
  "permissions": {
    "allow": [
      "Bash(./scripts/check.sh)",
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Read(data/equipo_pii.json)",
      "Edit(data/equipo_pii.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/check.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
